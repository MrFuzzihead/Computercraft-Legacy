local sDrive = nil
local tArgs = { ... }
if #tArgs > 0 then
	sDrive = tostring( tArgs[1] )
end

if sDrive == nil then
	print( "This is computer #"..os.getComputerID() )

	local label = os.getComputerLabel()
	if label then
		print( "This computer is labelled \""..label.."\"" )
	end

else
	-- An audio disc is not a data source, so report the track rather than trying to read it.
	if disk.hasAudio( sDrive ) then
		local title = disk.getAudioTitle( sDrive )
		if title then
			print( "Has audio track \""..title.."\"" )
		else
			print( "Has untitled audio" )
		end
		return
	end

	if not disk.hasData( sDrive ) then
		print( "No disk in drive "..sDrive )
		return
	end

	-- disk.getID returns nil for a data source that is not a ComputerCraft floppy, such as a
	-- mount provided by an addon.
	local nID = disk.getID( sDrive )
	if nID then
		print( "The disk is #"..nID )
	else
		print( "Non-disk data source" )
	end

	local label = disk.getLabel( sDrive )
	if label then
		print( "Labelled \""..label.."\"" )
	end
end
