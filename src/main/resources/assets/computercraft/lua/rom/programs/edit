-- Get file to edit
local tArgs = { ... }
if #tArgs == 0 then
	local programName = arg[0] or fs.getName( shell.getRunningProgram() )
	print( "Usage: " .. programName .. " <path>" )
	return
end

-- Error checking
local sPath = shell.resolve( tArgs[1] )
local bReadOnly = fs.isReadOnly( sPath )
if fs.exists( sPath ) and fs.isDir( sPath ) then
	print( "Cannot edit a directory." )
	return
end

-- Create files with the configured extension by default (edit.default_extension, e.g. "lua").
-- Only applies to a *new* file whose name has no extension, so an existing path is never changed.
if not fs.exists( sPath ) and not string.find( sPath, "%." ) then
	local sExtension = settings.get( "edit.default_extension" )
	if type( sExtension ) == "string" and sExtension ~= "" then
		sPath = sPath .. "." .. sExtension
	end
end

local x,y = 1,1
local w,h = term.getSize()
local scrollX, scrollY = 0,0

local tLines = {}
-- The lexer state each line starts in, so a multi-line string or comment stays coloured on every
-- line it covers. false means "nothing outstanding"; a table is the lexer's continuation.
local tLineLexStates = {}
local bRunning = true

-- Colours
local isColour = term.isColour()
local highlightColour, keywordColour, textColour, bgColour, errorColour
if isColour then
	bgColour = colours.black
	textColour = colours.white
	highlightColour = colours.yellow
	keywordColour = colours.yellow
	errorColour = colours.red
else
	bgColour = colours.black
	textColour = colours.white
	highlightColour = colours.white
	keywordColour = colours.white
	errorColour = colours.white
end

-- Menus
-- The bar itself lives in cc.internal.menu, shared with `paint`: it handles keyboard *and* mouse
-- (a click on the bar opens the menu, a click on an item picks it), which is why the editor does
-- not draw its own any more.
local menu = require "cc.internal.menu"
local current_menu
local tMenuItems = {}
if not bReadOnly then
    table.insert( tMenuItems, "Save" )
end
if shell.openTab then
    table.insert( tMenuItems, "Run" )
end
if peripheral.find( "printer" ) then
    table.insert( tMenuItems, "Print" )
end
table.insert( tMenuItems, "Exit" )

-- The status line: either the hint for opening the menu, or the result of the last action.
-- A message passed with ok == false is drawn in red, so a failed save is distinguishable from a
-- successful one instead of both being yellow.
local status_ok, status_text
local function set_status( text, ok )
	status_ok = ok ~= false
	status_text = text
end

if bReadOnly then
	set_status( "File is read only", false )
elseif fs.getFreeSpace( sPath ) < 1024 then
	set_status( "Disk is low on space", false )
else
	local sMessage
	if isColour then
		sMessage = "Press Ctrl or click here to access menu"
	else
		sMessage = "Press Ctrl to access menu"
	end

	if string.len( sMessage ) > w - 5 then
		sMessage = "Press Ctrl for menu"
	end

	set_status( sMessage )
end

local function load( _sPath )
	tLines = {}
	if fs.exists( _sPath ) then
		local file = io.open( _sPath, "r" )
		local sLine = file:read()
		while sLine do
			table.insert( tLines, sLine )
			sLine = file:read()
		end
		file:close()
	end
	
	if #tLines == 0 then
		table.insert( tLines, "" )
	end

	-- One state entry per line: the first line always starts fresh.
	tLineLexStates = { false }
end

local function save( _sPath )
	-- Create intervening folder
	local sDir = _sPath:sub(1, _sPath:len() - fs.getName(_sPath):len() )
	if not fs.exists( sDir ) then
		fs.makeDir( sDir )
	end

	-- Save
	local file = nil
	local function innerSave()
		file = fs.open( _sPath, "w" )
		if file then
			for n, sLine in ipairs( tLines ) do
				file.write( sLine .. "\n" )
			end
		else
			error( "Failed to open ".._sPath )
		end
	end
	
	local ok, err = pcall( innerSave )
	if file then 
		file.close()
	end
	return ok, err
end

local tokens = require "cc.internal.syntax.parser".tokens
local lex_one = require "cc.internal.syntax.lexer".lex_one

-- Token colours, following the theme chosen above. Non-colour terminals fall back to shades of
-- grey so strings and comments are still distinguishable from code.
local tokenColours = {
	[ tokens.STRING ] = term.isColour() and colours.red or textColour,
	[ tokens.COMMENT ] = term.isColour() and colours.green or colours.lightGrey,
	[ tokens.NUMBER ] = term.isColour() and colours.magenta or textColour,
}
for _, token in pairs( tokens ) do
	if not tokenColours[ token ] then
		tokenColours[ token ] = textColour
	end
end
-- Keywords share one colour, whatever the terminal supports.
for _, name in ipairs {
	"AND", "BREAK", "DO", "ELSE", "ELSEIF", "END", "FALSE", "FOR", "FUNCTION", "GOTO", "IF", "IN",
	"LOCAL", "NIL", "NOT", "OR", "REPEAT", "RETURN", "THEN", "TRUE", "UNTIL", "WHILE",
} do
	local token = tokens[ name ]
	if token then tokenColours[ token ] = keywordColour end
end

-- The lexer reports syntax errors through this context; the editor has nothing to say about them
-- (it highlights half-written code all the time), so it just swallows them.
local lexContext = { line = function() end, report = function() end }

--[[- Whether two continuation states are the same.

A continuation is either `false`/`nil` (nothing outstanding) or a table produced by the lexer. They
are compared shallowly: the lexer only ever produces small state tables, and comparing them decides
whether the following lines need re-highlighting.
]]
local function sameState( a, b )
	if a == b then return true end
	if type( a ) ~= "table" or type( b ) ~= "table" then return false end
	for k, v in pairs( a ) do
		if b[ k ] ~= v then return false end
	end
	for k in pairs( b ) do
		if a[ k ] == nil then return false end
	end
	return true
end

--[[- Draws one line, returning the lexer state the next line starts in.

Colouring is driven by the real lexer rather than by pattern matching, which is what makes a
multi-line string or a long comment stay coloured on every line it covers: each line is lexed
starting from the state the previous line left behind.

@tparam number nLine the line number to draw
@return The continuation state for the line after this one.
]]
local function lexLine( nLine, bDraw )
	local sContents = tLines[ nLine ]
	local nPos, nToken, nFinish

	local sState = tLineLexStates[ nLine ]
	if type( sState ) == "table" then
		-- Resume inside a string or comment started on an earlier line.
		nToken, nFinish, _, sState = sState[1]( lexContext, sContents, table.unpack( sState, 2 ) )
		nPos = 1
	else
		nPos = 1
		nToken, _, nFinish, _, sState = lex_one( lexContext, sContents, 1 )
	end

	local nColour = term.getTextColour()
	while nToken do
		local newColour = tokenColours[ nToken ] or textColour
		if bDraw and newColour ~= nColour then
			term.setTextColour( newColour )
			nColour = newColour
		end
		if bDraw then
			term.write( string.sub( sContents, nPos, nFinish ) )
		end

		nPos = nFinish + 1
		-- A continuation means the lexer stopped at the end of the line.
		if sState then break end

		nToken, _, nFinish, _, sState = lex_one( lexContext, sContents, nPos )
	end

	if bDraw then
		term.write( string.sub( sContents, nPos ) )
		term.setTextColour( textColour )
	end
	return sState or false
end

--[[- Draws one line, returning the lexer state the next line starts in.

Colouring is driven by the real lexer rather than by pattern matching, which is what keeps a
multi-line string or a long comment coloured on every line it covers: each line is lexed starting
from the state the previous line left behind.

@tparam number nLine the line number to draw
@return The continuation state for the line after this one.
]]
local function writeHighlighted( nLine )
	return lexLine( nLine, true )
end

local tCompletions
local nCompletion

local tCompleteEnv = _ENV
local function complete( sLine )
    -- edit.autocomplete (on by default) can be turned off for people who want a plain editor.
    if settings.get( "edit.autocomplete", true ) == false then
        return nil
    end

    -- Include ':' so a method name after a dot-chain is completed as a whole ("table.ins" ->
    -- "table.insert" rather than completing "ins" on its own).
    local nStartPos = string.find( sLine, "[a-zA-Z0-9_%.:]+$" )
    if nStartPos then
        sLine = string.sub( sLine, nStartPos )
    end
    if #sLine > 0 then
        return textutils.complete( sLine, tCompleteEnv )
    end
    return nil
end

local function recomplete()
    local sLine = tLines[y]
    if not current_menu and not bReadOnly and x == string.len(sLine) + 1 then
        tCompletions = complete( sLine )
        if tCompletions and #tCompletions > 0 then
            nCompletion = 1
        else
            nCompletion = nil
        end
    else
        tCompletions = nil
        nCompletion = nil
    end
end

local function writeCompletion( sLine )
    if nCompletion then
        local sCompletion = tCompletions[ nCompletion ]
        term.setTextColor( colours.white )
        term.setBackgroundColor( colours.grey )
        term.write( sCompletion )
        term.setTextColor( textColour )
        term.setBackgroundColor( bgColour )
    end
end

--[[- Redraws lines, following the lexer state downwards.

Editing a line can change how the lines *after* it are coloured: opening a long comment, or
closing one. So drawing continues past `_nEndY` while the state handed to the next line differs from
the one recorded for it, stopping at the bottom of the screen. That keeps a long comment correctly
coloured without redrawing the whole file on every keystroke.
]]
local function redrawLines( _nLine, _nEndY )
    if not _nEndY then _nEndY = _nLine end

    local nCursorX, nCursorY = x, y
    local bChanged = false
    while ( bChanged or _nLine <= _nEndY ) and _nLine - scrollY < h do
        local nScreenY = _nLine - scrollY
        if nScreenY < 1 then
            -- Above the viewport: drawing it would write over the visible screen, so skip to the
            -- first visible line and force a full redraw from there.
            _nLine = scrollY + 1
            bChanged = true
            nScreenY = 1
        end
        do
            term.setCursorPos( 1 - scrollX, nScreenY )
            term.clearLine()

            local sContents = tLines[ _nLine ]
            if sContents == nil then break end

            local sContinuation = writeHighlighted( _nLine )
            if nCursorY == nScreenY and nCursorX == #sContents + 1 then
                writeCompletion( sContents )
            end

            -- Always record the state for the next line: leaving it nil would make that line lex
            -- from scratch next time, losing the comment/string it is inside. Re-highlight the
            -- following lines only when a state we already knew has moved.
            if sContinuation == nil then sContinuation = false end
            local sPrevious = tLineLexStates[ _nLine + 1 ]
            local bKnown = sPrevious ~= nil
            if not bKnown or not sameState( sPrevious, sContinuation ) then
                tLineLexStates[ _nLine + 1 ] = sContinuation
                bChanged = bKnown
            else
                bChanged = false
            end

            _nLine = _nLine + 1
        end
    end

    term.setTextColour( textColour )
    term.setCursorPos( x - scrollX, y - scrollY )
end

local function redrawText()
    -- The top of the screen can start part-way through a string, so the state for the first visible
    -- line has to be computed from the top of the file once. After that it is cached and edits only
    -- re-lex what they touch.
    if tLineLexStates[ scrollY + 1 ] == nil then
        for i = 1, scrollY do
            if tLines[ i ] == nil then break end
            tLineLexStates[ i + 1 ] = lexLine( i, false )
        end
    end
    redrawLines( scrollY + 1, scrollY + h - 1 )
end

local function redrawLine( _nY )
    if tLines[ _nY ] then
        redrawLines( _nY )
    end
end

local function redrawMenu()
    -- Clear line
    term.setCursorPos( 1, h )
	term.clearLine()

    -- Draw line numbers
    term.setCursorPos( w - string.len( "Ln "..y ) + 1, h )
    term.setTextColour( highlightColour )
    term.write( "Ln " )
    term.setTextColour( textColour )
    term.write( y )

    term.setCursorPos( 1, h )
	if current_menu then
        -- Draw menu
		menu.draw( current_menu )
    else
        -- Draw status
        term.setTextColour( status_ok and highlightColour or errorColour )
        term.write( status_text )
        term.setTextColour( textColour )
    end

	-- Reset cursor, and only blink it when the menu is closed
	term.setCursorPos( x - scrollX, y - scrollY )
	term.setCursorBlink( not current_menu )
end

local tMenuFuncs = { 
	Save = function()
		if bReadOnly then
			set_status( "Access denied", false )
		else
			local ok, err = save( sPath )
			if ok then
				set_status( "Saved to "..sPath )
			elseif err then
				-- The reason is more useful than the path the user already knows.
				set_status( "Error saving: "..tostring( err ), false )
			else
				set_status( "Error saving to "..sPath, false )
			end
		end
		redrawMenu()
	end,
	Print = function()
		local printer = peripheral.find( "printer" )
		if not printer then
			set_status( "No printer attached", false )
			return
		end

		local nPage = 0
		local sName = fs.getName( sPath )
		if printer.getInkLevel() < 1 then
			set_status( "Printer out of ink", false )
			return
		elseif printer.getPaperLevel() < 1 then
			set_status( "Printer out of paper", false )
			return
		end

		local screenTerminal = term.current()
		local printerTerminal = {
			getCursorPos = printer.getCursorPos,
			setCursorPos = printer.setCursorPos,
			getSize = printer.getPageSize,
			write = printer.write,
		}
		printerTerminal.scroll = function()
			if nPage == 1 then
				printer.setPageTitle( sName.." (page "..nPage..")" )			
			end
			
			while not printer.newPage()	do
				if printer.getInkLevel() < 1 then
					set_status( "Printer out of ink, please refill", false )
				elseif printer.getPaperLevel() < 1 then
					set_status( "Printer out of paper, please refill", false )
				else
					set_status( "Printer output tray full, please empty", false )
				end
	
				term.redirect( screenTerminal )
				redrawMenu()
				term.redirect( printerTerminal )

				sleep(0.5)
			end

			nPage = nPage + 1
			if nPage == 1 then
				printer.setPageTitle( sName )
			else
				printer.setPageTitle( sName.." (page "..nPage..")" )
			end
		end
		
		-- The caller has already dismissed the menu; keep it off the screen while the terminal is
		-- redirected to the printer.
		local old_menu = current_menu
		current_menu = nil
		term.redirect( printerTerminal )
		local ok, error = pcall( function()
			term.scroll()
			for n, sLine in ipairs( tLines ) do
				print( sLine )
			end
		end )
        term.redirect( screenTerminal )
		if not ok then
			print( error )
		end
		
		while not printer.endPage() do
			set_status( "Printer output tray full, please empty", false )
			redrawMenu()
			sleep( 0.5 )
		end
		current_menu = old_menu
			
		if nPage > 1 then
			set_status( "Printed "..nPage.." Pages" )
		else
			set_status( "Printed 1 Page" )
		end
		redrawMenu()
	end,
	Exit = function()
		bRunning = false
	end,
	Run = function()
		-- Launch through cc.internal.edit_runner rather than running a copy of the file: the
		-- runner loads the buffer itself, so a runtime error names this file and points at the
		-- right line even when the buffer was never saved, and it holds the tab open so the
		-- error can be read instead of vanishing with the tab.
		local sTitle = fs.getName( sPath )
		if sTitle:sub( -4 ) == ".lua" then
			sTitle = sTitle:sub( 1, -5 )
		end
		local sTempPath = (bReadOnly and ".temp." or fs.combine( fs.getDir( sPath ), ".temp." )) .. sTitle
		if fs.exists( sTempPath ) then
			set_status( "Error saving to "..sTempPath, false )
			redrawMenu()
			return
		end

		local file = fs.open( sTempPath, "w" )
		if not file then
			set_status( "Error saving to "..sTempPath, false )
			redrawMenu()
			return
		end
		local runHandler = [[return require("cc.internal.edit_runner")(%q, %q, %q)]]
		file.write( runHandler:format( sTitle, "@/" .. sPath, table.concat( tLines, "\n" ) ) )
		file.close()

		local nTask = shell.openTab( "/" .. sTempPath )
		if nTask then
			shell.switchTab( nTask )
		else
			set_status( "Error starting Task", false )
		end
		fs.delete( sTempPath )
		redrawMenu()
	end
}

-- Runs the action named by a menu item, and closes the menu.
local function doMenuItem( _sItem )
	current_menu = nil
	local fn = tMenuFuncs[ _sItem ]
	if fn then fn() end
	redrawMenu()
end

-- Feeds an event to the menu bar. Returns true if the menu is still open.
local function handleMenuEvent( _id, _p1, _p2, _p3 )
	local result = menu.handle_event( current_menu, _id, _p1, _p2, _p3 )
	if result == false then
		current_menu = nil
		redrawMenu()
		return false
	elseif result ~= nil then
		doMenuItem( result )
		return false
	end
	return true
end

local function setCursor( newX, newY )
    local oldX, oldY = x, y
    x, y = newX, newY
	local screenX = x - scrollX
	local screenY = y - scrollY
	
	local bRedraw = false
	if screenX < 1 then
		scrollX = x - 1
		screenX = 1
		bRedraw = true
	elseif screenX > w then
		scrollX = x - w
		screenX = w
		bRedraw = true
	end
	
	if screenY < 1 then
		scrollY = y - 1
		screenY = 1
		bRedraw = true
	elseif screenY > h-1 then
		scrollY = y - (h-1)
		screenY = h-1
		bRedraw = true
	end

	recomplete()
	if bRedraw then
		redrawText()
	elseif y ~= oldY then
	    redrawLine( oldY )
	    redrawLine( y )
	else
	    redrawLine( y )
	end
	term.setCursorPos( screenX, screenY )

	redrawMenu()
end

-- Actual program functionality begins
load(sPath)

term.setBackgroundColour( bgColour )
term.clear()
term.setCursorPos(x,y)
term.setCursorBlink( true )

recomplete()
redrawText()
redrawMenu()

local function acceptCompletion()
    if nCompletion then
        -- Find the common prefix of all the other suggestions which start with the same letter as the current one
        local sCompletion = tCompletions[ nCompletion ]
        local sFirstLetter = string.sub( sCompletion, 1, 1 )
        local sCommonPrefix = sCompletion
        for n=1,#tCompletions do
            local sResult = tCompletions[n]
            if n ~= nCompletion and string.find( sResult, sFirstLetter, 1, true ) == 1 then
                while #sCommonPrefix > 1 do
                    if string.find( sResult, sCommonPrefix, 1, true ) == 1 then
                        break
                    else
                        sCommonPrefix = string.sub( sCommonPrefix, 1, #sCommonPrefix - 1 )
                    end
                end
            end
        end

        -- Append this string
        tLines[y] = tLines[y] .. sCommonPrefix
        setCursor( x + string.len( sCommonPrefix ), y )
    end
end

-- Handle input
while bRunning do
	local sEvent, param, param2, param3 = os.pullEvent()

	if sEvent == "key" then
		if current_menu then
			handleMenuEvent( sEvent, param, param2, param3 )
		elseif param == keys.up then
			-- Up
			if nCompletion then
				-- Cycle completions
				nCompletion = nCompletion - 1
				if nCompletion < 1 then
					nCompletion = #tCompletions
				end
				redrawLine(y)
			elseif y > 1 then
				-- Move cursor up
				setCursor(
					math.min( x, string.len( tLines[y - 1] ) + 1 ),
					y - 1
				)
			end

		elseif param == keys.down then
			-- Down
			if nCompletion then
				-- Cycle completions
				nCompletion = nCompletion + 1
				if nCompletion > #tCompletions then
					nCompletion = 1
				end
				redrawLine(y)
			elseif y < #tLines then
				-- Move cursor down
				setCursor(
					math.min( x, string.len( tLines[y + 1] ) + 1 ),
					y + 1
				)
			end

		elseif param == keys.tab and not bReadOnly then
			-- Tab
			if nCompletion and x == string.len(tLines[y]) + 1 then
				-- Accept autocomplete
				acceptCompletion()
			else
				-- Indent, one level of four spaces to match CC:Tweaked's files
				local sLine = tLines[y]
				tLines[y] = string.sub(sLine,1,x-1) .. "    " .. string.sub(sLine,x)
				setCursor( x + 4, y )
			end

		elseif param == keys.pageUp then
			-- Page Up
			local newY
			if y - (h - 1) >= 1 then
				newY = y - (h - 1)
			else
				newY = 1
			end
			setCursor(
				math.min( x, string.len( tLines[newY] ) + 1 ),
				newY
			)

		elseif param == keys.pageDown then
			-- Page Down
			local newY
			if y + (h - 1) <= #tLines then
				newY = y + (h - 1)
			else
				newY = #tLines
			end
			local newX = math.min( x, string.len( tLines[newY] ) + 1 )
			setCursor( newX, newY )

		elseif param == keys.home then
			-- Home
			if x > 1 then
				setCursor(1,y)
			end

		elseif param == keys["end"] then
			-- End
			local nLimit = string.len( tLines[y] ) + 1
			if x < nLimit then
				setCursor( nLimit, y )
			end

		elseif param == keys.left then
			-- Left
			if x > 1 then
				setCursor( x - 1, y )
			elseif x == 1 and y > 1 then
				setCursor( string.len( tLines[y-1] ) + 1, y - 1 )
			end

		elseif param == keys.right then
			-- Right
			local nLimit = string.len( tLines[y] ) + 1
			if x < nLimit then
				setCursor( x + 1, y )
			elseif nCompletion and x == string.len(tLines[y]) + 1 then
				-- Accept autocomplete
				acceptCompletion()
			elseif x == nLimit and y < #tLines then
				-- Go to next line
				setCursor( 1, y + 1 )
			end

		elseif param == keys.delete and not bReadOnly then
			-- Delete
			local nLimit = string.len( tLines[y] ) + 1
			if x < nLimit then
				local sLine = tLines[y]
				tLines[y] = string.sub(sLine,1,x-1) .. string.sub(sLine,x+1)
				recomplete()
				redrawLine(y)
			elseif y < #tLines then
				tLines[y] = tLines[y] .. tLines[y+1]
				table.remove( tLines, y+1 )
				table.remove( tLineLexStates, y+1 )
				recomplete()
				redrawText()
			end

		elseif param == keys.backspace and not bReadOnly then
			-- Backspace
			if x > 1 then
				local sLine = tLines[y]
				-- Inside the leading whitespace, remove a whole indent level rather than one
				-- space: the cursor is where Tab/F2 put it, and undoing four keystrokes with one
				-- is what CC:Tweaked's editor does.
				if x > 4 and string.sub( sLine, x - 4, x - 1 ) == "    "
					and not string.sub( sLine, 1, x - 1 ):find( "%S" ) then
					tLines[y] = string.sub( sLine, 1, x - 5 ) .. string.sub( sLine, x )
					setCursor( x - 4, y )
				else
					-- Remove character
					tLines[y] = string.sub( sLine, 1, x - 2 ) .. string.sub( sLine, x )
					setCursor( x - 1, y )
				end
			elseif y > 1 then
				-- Remove newline
				local sPrevLen = string.len( tLines[y-1] )
				tLines[y-1] = tLines[y-1] .. tLines[y]
				table.remove( tLines, y )
				table.remove( tLineLexStates, y )
				setCursor( sPrevLen + 1, y - 1 )
				redrawText()
			end

		elseif ( param == keys.enter or param == keys.numPadEnter ) and not bReadOnly then
			-- Newline, keeping the current line's indentation
			local sLine = tLines[y]
			local _,spaces=string.find(sLine,"^[ ]+")
			if not spaces then
				spaces=0
			end
			tLines[y] = string.sub(sLine,1,x-1)
			table.insert( tLines, y+1, string.rep(' ',spaces)..string.sub(sLine,x) )
			-- The new line's state is unknown until it is drawn.
			table.insert( tLineLexStates, y+1, false )
			setCursor( spaces + 1, y + 1 )
			redrawText()

		elseif param == keys.leftCtrl or param == keys.rightCtrl or param == keys.rightAlt then
			-- Open the menu
			current_menu = menu.create( tMenuItems )
			redrawMenu()
		end

	elseif sEvent == "char" then
		if current_menu then
			handleMenuEvent( sEvent, param, param2, param3 )
		elseif not bReadOnly then
			-- Input text
			local sLine = tLines[y]
			tLines[y] = string.sub(sLine,1,x-1) .. param .. string.sub(sLine,x)
			setCursor( x + 1, y )
		end

	elseif sEvent == "paste" and not bReadOnly then
		-- A paste dismisses the menu rather than being swallowed, which is what upstream does.
		if current_menu then
			current_menu = nil
			redrawMenu()
		end

		local sLine = tLines[y]
		tLines[y] = string.sub(sLine,1,x-1) .. param .. string.sub(sLine,x)
		setCursor( x + string.len( param ), y )

	elseif sEvent == "mouse_click" then
		if current_menu then
			handleMenuEvent( sEvent, param, param2, param3 )
		elseif param == 1 then
			-- Left click
			local cx,cy = param2, param3
			if cy < h then
				local newY = math.min( math.max( scrollY + cy, 1 ), #tLines )
				local newX = math.min( math.max( scrollX + cx, 1 ), string.len( tLines[newY] ) + 1 )
				setCursor( newX, newY )
			else
				-- Clicking the footer opens the menu
				current_menu = menu.create( tMenuItems )
				redrawMenu()
			end
		end

	elseif sEvent == "mouse_scroll" then
		if not current_menu then
			if param == -1 then
				-- Scroll up
				if scrollY > 0 then
					-- Move cursor up
					scrollY = scrollY - 1
					redrawText()
				end

			elseif param == 1 then
				-- Scroll down
				local nMaxScroll = #tLines - (h-1)
				if scrollY < nMaxScroll then
					-- Move cursor down
					scrollY = scrollY + 1
					redrawText()
				end

			end
		end

	elseif sEvent == "term_resize" then
		w,h = term.getSize()
		setCursor( x, y )
		redrawMenu()
		redrawText()

	end
end

-- Cleanup
term.clear()
term.setCursorBlink( false )
term.setCursorPos( 1, 1 )